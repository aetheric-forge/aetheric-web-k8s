# Secret aethericforge-admin-config in namespace aetheric-forge.
# Replace placeholders with this app's credentials and actual platform endpoints.
# Normal admin mode; bootstrap state is optional when all these values are explicit.
Bootstrap__Enabled=false
Keycloak__Authority=https://sso.aethericforge.ca
Keycloak__Realm=int.aethericforge.ca
Keycloak__ClientId=aetheric-admin
Keycloak__ClientSecret=replace-me
# BlackCircuit's example uses this single-member operator Service; verify it here.
MongoDb__Host=forge-mongo-0.forge-mongo-svc.forge-mongo.svc.cluster.local
MongoDb__Port=27017
MongoDb__DirectConnection=true
Maintenance__MongoDb__DatabaseName=aetheric-maintenance
Maintenance__MongoDb__AuthenticationDatabase=aetheric-maintenance
Maintenance__MongoDb__Username=aetheric-maintenance
Maintenance__MongoDb__Password=replace-me
Membership__MongoDb__DatabaseName=aetheric-membership
Membership__MongoDb__AuthenticationDatabase=aetheric-membership
Membership__MongoDb__Username=aetheric-membership-admin
Membership__MongoDb__Password=replace-me
Redis__Host=redis.example
Redis__Port=6379
Redis__Ssl=false
Redis__Database=0
Workbench__Redis__Password=replace-me
ForgeCampus__Redis__Password=replace-me
RabbitMq__Host=rabbitmq.example
RabbitMq__Port=5672
RabbitMq__Username=aetheric-admin
RabbitMq__Password=replace-me
RabbitMq__VirtualHost=aetheric-admin
RabbitMq__Ssl=false
# Optional marketing management; omit this section when not provisioned.
# Marketing__MongoDb__DatabaseName=aetheric-marketing
# Marketing__MongoDb__AuthenticationDatabase=aetheric-marketing
# Marketing__MongoDb__Username=aetheric-marketing-admin
# Marketing__MongoDb__Password=replace-me
